<?xml version="1.0" encoding="utf-8"?>
<!-- Events are limited to the Live Caption package, so the service stays idle
     while other apps redraw. Window content is still read via getWindows(). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged"
    android:packageNames="com.google.android.as"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="50"
    android:canRetrieveWindowContent="true"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:settingsActivity="com.livesub.translate.MainActivity"
    android:description="@string/a11y_desc" />
